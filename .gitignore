# ============ 一、本地与私有内容：绝不进仓库 ============
# 项目记忆/脚本/临时件（含本地服务日志、探针、Edge 缓存）
.deepworks/

# 后台管理令牌（明文，泄露=任何人都能删反馈）
db/admin_token.txt

# 数字分身大模型 API 配置（含通义千问 API key 明文，绝不入库）
db/llm-config.json

# 本地自测数据库（含测试留言）
db/*.db
db/*.db-journal
db/*.db-wal
db/*.db-shm

# Python 缓存
__pycache__/
db/__pycache__/
*.pyc

# ============ 二、课程作业材料：不上线 ============
# 各版本整页截图与源码快照（体积大，且会与线上源码重复）
版本存档/
作业提交区/

# 构建产物/交付物副本（线上直接用根目录源码）
outputs/

# 长期源件库（报告 HTML/插图/PDF、站点插画原图、可复用脚本）—— 本地保留，不进公开仓库
报告源件/

# 会话里上传的原始素材（截图、docx、转换中间件）—— 属于对话资料，不是站点文件
uploads/

# 图片生成产物（AI 候选图 + meta，体积大且未采用；不是站点文件）
output/

# ============ 三、系统与编辑器 ============
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
*.log


# 云函数部署目录（含 DeepSeek key 副本，严禁入库）
deploy-fc/
